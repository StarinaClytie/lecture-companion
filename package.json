{
  "name": "lecture-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test tests/*.test.js",
    "desktop:mac": "node scripts/create-desktop-app.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "license": "UNLICENSED"
}
