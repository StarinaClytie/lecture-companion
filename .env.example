# Optional: enables live AI explanations, questions, and caption translation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Speech model is independent of OPENAI_MODEL (the text-answer model).
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Optional separate key; leave blank to reuse OPENAI_API_KEY.
OPENAI_TRANSCRIPTION_API_KEY=
